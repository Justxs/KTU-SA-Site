{
  "name": "ktu-sa-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxfmt --write . && oxlint --type-aware --fix .",
    "lint:check": "oxfmt --check . && oxlint --type-aware .",
    "typecheck": "next typegen && tsc --noEmit",
    "validate-locales": "node ./scripts/validate-locales.js",
    "check": "npm run lint:check && npm run typecheck && npm run validate-locales"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-share": "^5.3.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
