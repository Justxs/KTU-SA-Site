{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "crlf",
  "jsxSingleQuote": false,
  "sortPackageJson": false,
  "ignorePatterns": [".next/**", "node_modules/**", "public/**", "out/**", "build/**", "*.min.js"]
}
